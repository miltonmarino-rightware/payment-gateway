APP_ENV=development
APP_VERSION=0.2.0
APP_NAME=RightWare Payment Gateway
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/payment_gateway
REDIS_URL=redis://localhost:6379/0
API_KEY_PEPPER=change-me-with-64-char-secret
HMAC_SECRET=change-me-with-64-char-secret
AES_SECRET_KEY=change-me-with-64-char-hex-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
ALLOW_SANDBOX_RAW_CARD_INPUT=false
